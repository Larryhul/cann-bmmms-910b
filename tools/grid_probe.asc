// Time many shapes in one process. Used only to find which shapes the official
// test points are: it reads a shape list, reuses one pair of input buffers, and
// reports the best of a few runs per shape. Input values are a fixed pattern,
// because only the duration is wanted here.
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>
#include <chrono>
#include "acl/acl.h"

struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
#include "kernel.asc"

#define CHECK(call) do { const auto ret=(call); if(ret!=ACL_SUCCESS) { \
    fprintf(stderr,"ACL_ERROR %s code=%d\n",#call,int(ret)); return 2; } } while(0)

int main(int argc, char** argv)
{
    if (argc != 4) { fprintf(stderr, "shapes-file repeats device\n"); return 2; }
    FILE* list = fopen(argv[1], "r");
    if (!list) { fprintf(stderr, "cannot open %s\n", argv[1]); return 2; }
    const int repeats = atoi(argv[2]);
    const int device = atoi(argv[3]);

    CHECK(aclInit(nullptr));
    CHECK(aclrtSetDevice(device));
    int64_t cores = 0;
    CHECK(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_CUBE_CORE_NUM, &cores));
    aclrtStream stream = nullptr;
    CHECK(aclrtCreateStream(&stream));

    // B*M*K and B*N*K are both capped at 2^26 elements by the problem.
    const size_t cap = (size_t(1) << 26) * 2;
    void *ad = nullptr, *bd = nullptr, *yd = nullptr;
    CHECK(aclrtMalloc(&ad, cap, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&bd, cap, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&yd, 64 * 4, ACL_MEM_MALLOC_HUGE_FIRST));
    // 0x3C3C is 1.0293 as fp16 and 0.0115 as bf16: normal in both, so no
    // denormal slow path and no overflow once accumulated.
    CHECK(aclrtMemset(ad, cap, 0x3C, cap));
    CHECK(aclrtMemset(bd, cap, 0x3C, cap));

    char line[256];
    while (fgets(line, sizeof(line), list)) {
        long long B, M, N, K;
        int dtype = 1, ta = 0, tb = 0;
        const int read = sscanf(line, "%lld %lld %lld %lld %d %d %d",
                                &B, &M, &N, &K, &dtype, &ta, &tb);
        if (read < 4) continue;
        if (B * M * K > (1LL << 26) || B * N * K > (1LL << 26)) continue;

        int64_t ash[] = {B, ta ? K : M, ta ? M : K};
        int64_t bsh[] = {B, tb ? N : K, tb ? K : N};
        int64_t ysh[] = {B};
        TensorInfo ai{ash, 3, dtype}, bi{bsh, 3, dtype}, yi{ysh, 1, 0};
        TensorGroupInfo ag{&ai, 1}, bg{&bi, 1}, yg{&yi, 1};

        {
            // The first run doubles as the warm-up and as a cheap guard: a
            // shape that lands on the scalar fallback takes milliseconds, and
            // repeating it would stall the whole grid.
            const auto probeStart = std::chrono::steady_clock::now();
            run_kernel((GM_ADDR)ad, ag, (GM_ADDR)bd, bg, (GM_ADDR)yd, yg,
                       cores, stream, ta, tb);
            if (aclrtSynchronizeStreamWithTimeout(stream, 20000) != ACL_SUCCESS) {
                printf("GRID %lld %lld %lld %lld %d %d %d timeout\n",
                       B, M, N, K, dtype, ta, tb);
                fflush(stdout);
                goto next;
            }
            const double first = std::chrono::duration<double, std::micro>(
                std::chrono::steady_clock::now() - probeStart).count();
            if (first > 3000.0) {
                printf("GRID %lld %lld %lld %lld %d %d %d %.2f slow\n",
                       B, M, N, K, dtype, ta, tb, first);
                fflush(stdout);
                goto next;
            }
        }
        run_kernel((GM_ADDR)ad, ag, (GM_ADDR)bd, bg, (GM_ADDR)yd, yg,
                   cores, stream, ta, tb);
        CHECK(aclrtSynchronizeStreamWithTimeout(stream, 20000));
        {
            double best = 1e18;
            for (int i = 0; i < repeats; ++i) {
                const auto start = std::chrono::steady_clock::now();
                run_kernel((GM_ADDR)ad, ag, (GM_ADDR)bd, bg, (GM_ADDR)yd, yg,
                           cores, stream, ta, tb);
                if (aclrtSynchronizeStreamWithTimeout(stream, 20000) != ACL_SUCCESS) {
                    best = -1;
                    break;
                }
                const double us = std::chrono::duration<double, std::micro>(
                    std::chrono::steady_clock::now() - start).count();
                if (us < best) best = us;
            }
            printf("GRID %lld %lld %lld %lld %d %d %d %.2f\n",
                   B, M, N, K, dtype, ta, tb, best);
            fflush(stdout);
        }
    next:;
    }
    fclose(list);
    CHECK(aclrtFree(ad)); CHECK(aclrtFree(bd)); CHECK(aclrtFree(yd));
    CHECK(aclrtDestroyStream(stream));
    CHECK(aclrtResetDevice(device));
    CHECK(aclFinalize());
    return 0;
}
